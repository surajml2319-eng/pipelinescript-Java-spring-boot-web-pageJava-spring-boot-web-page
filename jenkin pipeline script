pipeline {
    agent any
    
    stages {
        stage("Clone Code") {
            steps {
                echo "Cloning the code"
                git branch: 'main', credentialsId: 'github', url: 'https://github.com/surajml2319-eng/Java-spring-boot-web-page.git'
            }
        }
        
        stage("Maven Unit Test") {
            steps {
                dir("/var/lib/jenkins/workspace/java_web") {
                    sh 'mvn test'
                }
            }
        }
        
        stage("Maven Build") {
            steps {
                dir("/var/lib/jenkins/workspace/java_web") {
                    sh 'mvn clean install'
                }
            }
        }
        
        stage("Maven Integration Test") {
            steps {
                dir("/var/lib/jenkins/workspace/java_web") {
                    sh 'mvn verify'
                }
            }
        }
        
        stage("Build Docker Image") {
            steps {
                echo "Building the image"
                sh "docker build -t ci-cd-pipeline ."
            }
        }
        
        stage("Push to Docker Hub") {
            steps {
                script { 
                    withCredentials([usernamePassword(credentialsId: 'dockerHub', usernameVariable: 'docker_user', passwordVariable: 'docker_pass')]) {
                        def JOB = env.JOB_NAME.toLowerCase() // Converts job name to lower-case
                        
                        // 1. Secure login using triple single quotes
                        sh '''
                            printf '%s' "$docker_pass" | docker login -u "$docker_user" --password-stdin
                        '''
                        
                        // 2. Tag the local image with version and latest tags
                        sh "docker tag ci-cd-pipeline ${docker_user}/${JOB}:v${BUILD_NUMBER}"
                        sh "docker tag ci-cd-pipeline ${docker_user}/${JOB}:latest"
                        
                        // 3. Push both tags to Docker Hub
                        sh "docker push ${docker_user}/${JOB}:v${BUILD_NUMBER}"
                        sh "docker push ${docker_user}/${JOB}:latest"
                    }
                }
            }
        }
        
        stage("Deploy to Kubernetes") {
            steps {
                script {
                    dir("/var/lib/jenkins/workspace/java_web") {
                        // Bind the secret file to the KUBECONFIG environment variable directly
                        withKubeConfig(caCertificate: '', clusterName: '', contextName: '', credentialsId: 'kubernetes', namespace: '', restrictKubeConfigAccess: false, serverUrl: '') {
                            sh "kubectl version --client"
                            sh "kubectl delete pods --all --namespace=default || true"
                            sh "kubectl apply -f deployment.yaml"
                            sh "kubectl apply -f service.yaml"        
                        }
                    }
                }
            }
        }
    }
}
